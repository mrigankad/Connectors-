# Copy to .env for local development. Never commit real values.
WAYAM_DATABASE_URL=postgresql://wayam:wayam@127.0.0.1:5432/wayam_connectors
WAYAM_TEST_DATABASE_URL=postgresql://wayam:wayam@127.0.0.1:5432/wayam_connectors_test
# Local secret backend: 32 random bytes, base64 (python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())")
WAYAM_LOCAL_SECRET_KEY=
WAYAM_SECRET_BACKEND=local
# Bootstrap API key for the first tenant admin (hashed in the database, see `wayam-connectors create-tenant`)
WAYAM_ENV=development
